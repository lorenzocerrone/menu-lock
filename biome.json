{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "ignoreUnknown": true, "includes": ["**", "!docs/REWRITE_PLAN.md", "!public/images"] },
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
	"overrides": [
		{
			"includes": ["data/**", "schema/**"],
			"json": { "formatter": { "indentStyle": "space", "indentWidth": 2 } }
		},
		{
			"includes": ["data/ingredients.json"],
			"formatter": { "enabled": false }
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"react",
											"react-dom",
											"react/*",
											"react-dom/*",
											"@tanstack/*",
											"zustand",
											"zustand/*",
											"motion",
											"motion/*",
											"vaul",
											"@dnd-kit/*",
											"**/state/**",
											"**/ui/**",
											"**/routes/**"
										],
										"message": "src/lib is pure logic: no React, no DOM, no store. Pass what you need in as arguments."
									}
								]
							}
						},
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"window": "src/lib is pure logic: no browser globals.",
									"document": "src/lib is pure logic: no browser globals.",
									"localStorage": "src/lib is pure logic: storage lives in src/state/storage.ts.",
									"sessionStorage": "src/lib is pure logic: no browser globals.",
									"navigator": "src/lib is pure logic: no browser globals.",
									"location": "src/lib is pure logic: no browser globals.",
									"history": "src/lib is pure logic: no browser globals."
								}
							}
						}
					}
				}
			}
		}
	]
}
