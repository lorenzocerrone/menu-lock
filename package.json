{
	"name": "menu-lock",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "menu.lock: recipes, a meal plan that lives in the URL, and the grocery list resolved from it.",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "biome check . && tsc --noEmit && vitest run",
		"e2e": "playwright test",
		"shots": "VITE_LAB=1 vite build && tsx scripts/shots.ts",
		"schema": "tsx scripts/gen-schema.ts && biome format --write schema"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource/space-grotesk": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@tanstack/react-router": "^1.170.46",
		"motion": "^14.14.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"vaul": "^1.1.2",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
