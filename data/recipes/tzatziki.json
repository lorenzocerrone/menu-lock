  "description": "Cool yogurt dip with grated cucumber, garlic and mint.",
  "cuisine": "Greek",
  "tags": ["party", "quick", "no-cook"],
  "prepTime": 15,
  "ingredients": [
    {
      "ingredient": "greek_yogurt",
      "amount": 500,
      "unit": "g"
    },
    {
      "ingredient": "cucumber",
