  "title": "Beef Stew with Wine and Olives",
  "author": "Lorenzo",
  "servings": 4,
  "description": "Beef braised slowly in red wine with olives and rosemary until it falls apart.",
  "cuisine": "Italian",
  "tags": ["main", "comfort", "make-ahead"],
  "prepTime": 20,
  "cookTime": 120,
  "ingredients": [
