    },
    {
      "ingredient": "olive_oil",
      "amount": 1,
      "unit": "tbsp"
    },
    {
      "ingredient": "oregano",
      "amount": 1,
      "unit": "g"
    },
    {
      "ingredient": "salt"
    }
