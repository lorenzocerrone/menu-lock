{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Equals the file name. Never changes once published."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "servings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cuisine": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prepTime": {
      "description": "Minutes.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cookTime": {
      "description": "Minutes.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "image": {
      "description": "A file in public/images/. Absent means the shared placeholder.",
      "type": "string",
      "minLength": 1
    },
    "ingredients": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ingredient": {
            "type": "string",
            "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
            "description": "A key of data/ingredients.json."
          },
          "amount": {
            "description": "Absent means \"to taste\".",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "description": "g kg ml l tsp tbsp cup pcs, the ingredient's piece label, or any word (\"ball\"). Absent means a count of pieces. An amount that doesn't convert into the shopping unit is listed beside the total.",
            "type": "string",
            "minLength": 1
          },
          "note": {
            "description": "Shown after the name: \"finely chopped\".",
            "type": "string",
            "minLength": 1
          },
          "optional": {
            "type": "boolean"
          }
        },
        "required": ["ingredient"],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": ["id", "title", "author", "servings", "ingredients", "steps"],
  "additionalProperties": false
}
